# Optional. Google Analytics 4 measurement ID (G-XXXXXXXXXX). When unset, no
# analytics script is rendered — dev and preview stay clean.
PUBLIC_GA_MEASUREMENT_ID=

# Supabase project URL for the /book flow (defaults to the Tenorworth project when unset)
# PUBLIC_SUPABASE_URL=https://rpvwacqgwuthmnvzqdgs.supabase.co

# Cloudflare Turnstile site key (public; guards the /book and /card forms).
# Secret key lives in `supabase secrets` as TURNSTILE_SECRET_KEY.
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEvbIaLy-oF4NOKu
