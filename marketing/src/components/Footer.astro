---
import Wordmark from './Wordmark.astro';
import { SITE, NAV } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mt-28 border-t border-cream-line bg-cream-deep/60">
  <div class="container-wide grid gap-10 py-14 text-sm sm:grid-cols-3">
    <div>
      <Wordmark markClass="h-6 w-auto" textClass="text-lg" />
      <p class="mt-3 max-w-xs text-ink-muted text-pretty">{SITE.tagline} Working AI for regulated business in {SITE.region}.</p>
    </div>
    <div>
      <h4 class="eyebrow mb-3">Practice</h4>
      <ul class="space-y-2.5">
        {NAV.map((l) => <li><a href={l.href} class="transition hover:text-brass-deep">{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h4 class="eyebrow mb-3">Reach us</h4>
      <ul class="space-y-2.5">
        <li><a href={`mailto:${SITE.email}`} class="transition hover:text-brass-deep">{SITE.email}</a></li>
        {SITE.phone && <li><a href={`tel:${SITE.phone}`} class="transition hover:text-brass-deep">{SITE.phoneDisplay}</a></li>}
        {SITE.linkedin && <li><a href={SITE.linkedin} rel="me noopener" class="transition hover:text-brass-deep">LinkedIn</a></li>}
        <li><a href="/privacy" class="transition hover:text-brass-deep">Privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream-line">
    <div class="container-wide flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-ink-muted">
      <span>© {year} {SITE.legalEntity}, doing business as {SITE.name}. All rights reserved.</span>
      <span>{SITE.region}</span>
    </div>
  </div>
</footer>
