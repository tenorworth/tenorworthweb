---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { INDUSTRIES } from '../config/industries';
import { formatDate } from '../lib/posts';

export interface Props { post: CollectionEntry<'blog'>; eager?: boolean }
const { post, eager = false } = Astro.props;
const d = post.data;
const industry = INDUSTRIES[d.industry];
---
<article class="group flex flex-col">
  <a href={`/insights/${post.id}`} class="block overflow-hidden rounded-lg" aria-hidden="true" tabindex="-1">
    <Image
      src={d.heroImage}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, calc(100vw - 3rem)"
      format="webp"
      quality={78}
      loading={eager ? 'eager' : 'lazy'}
      class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
    />
  </a>
  <p class="eyebrow mt-5">{industry.name}</p>
  <h3 class="mt-2 text-2xl leading-snug text-balance">
    <a href={`/insights/${post.id}`} class="transition hover:text-brass-deep">{d.title}</a>
  </h3>
  <p class="mt-3 leading-relaxed text-ink-muted text-pretty">{d.description}</p>
  <p class="mt-4 text-xs text-ink-muted"><time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time> · {d.region}</p>
</article>
