---
import { Image } from 'astro:assets';
import { contactHref, SITE, AUTHOR } from '../config/site';
export interface Props { headline?: string; body?: string; source?: string; principal?: boolean }
const {
  headline = 'Start with a conversation, not a proposal.',
  body = 'Thirty minutes. Bring the workflow that costs you the most time, and the compliance question you assume will block it. We will tell you honestly whether AI belongs there.',
  source = 'cta',
  principal = false,
} = Astro.props;

// Optional: the person the visitor will actually talk to, shown beside the
// buttons. Same photo as /about; renders nothing while the file is missing.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/arka-bala.{jpg,jpeg,png}', { eager: true });
const photo = principal ? Object.values(photos)[0]?.default : undefined;
---
<section class="container-wide mt-28">
  <div class="rounded-lg bg-ink px-8 py-14 text-cream sm:px-14 sm:py-16">
    <div class="rule-brass mb-6"></div>
    <h2 class="max-w-2xl text-3xl text-balance sm:text-4xl">{headline}</h2>
    <p class="mt-5 max-w-2xl text-cream/75 text-pretty">{body}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={contactHref(source)} class="btn-on-ink" data-event="cta_click" data-source={source}>Book a call</a>
      <a href={`mailto:${SITE.email}`} class="btn-secondary border-cream/30 text-cream hover:border-brass hover:text-brass">Email {SITE.email}</a>
    </div>
    {photo && (
      <a href={AUTHOR.url} class="group mt-10 flex items-center gap-4 border-t border-cream/15 pt-8">
        <Image
          src={photo}
          alt=""
          width={112}
          height={112}
          class="h-14 w-14 shrink-0 rounded-full object-cover object-top ring-1 ring-brass/60"
        />
        <span class="text-sm leading-snug">
          <span class="block font-medium text-cream group-hover:text-brass transition">The call is with {AUTHOR.name}, {AUTHOR.title}.</span>
          <span class="block text-cream/65">The person who scopes the work is the person who builds it.</span>
        </span>
      </a>
    )}
  </div>
</section>
