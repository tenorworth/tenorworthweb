---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { contactHref } from '../config/site';

const sectors = [
  { name: 'Community healthcare', note: 'HIPAA, clinical workflows, patient communication.' },
  { name: 'Credit unions & RIAs', note: 'NCUA and SEC expectations, member and client data.' },
  { name: 'Law firms', note: 'Privilege, matter confidentiality, document-heavy work.' },
  { name: 'Life sciences', note: 'Validated processes, audit trails, quality systems.' },
  { name: 'Hospitality operators', note: 'Multi-site operations, guest data, thin margins.' },
];

const engagements = [
  {
    step: '01',
    name: 'AI Readiness Roadmap',
    length: 'Two weeks',
    body: 'A fixed-fee assessment of where AI will pay back inside your operation, what data and governance are already in place, and what is missing. You leave with a ranked plan, not a slide deck.',
  },
  {
    step: '02',
    name: 'Pilot',
    length: 'Four to six weeks',
    body: 'One workflow, your real data, a working system your staff use. Scope, success metric, and data boundaries are agreed in writing before a line of code is written.',
  },
  {
    step: '03',
    name: 'Fractional AI Architect',
    length: 'Monthly retainer',
    body: 'Senior ownership of your AI program without a full-time hire. Vendor decisions, model governance, staff enablement, and the next pilot, with the same person accountable throughout.',
  },
];

const principles = [
  { title: 'Governance before the demo', body: 'Audit trail, access control, and data boundaries are designed first. The questions your compliance officer will ask get answered before anyone sees a prototype.' },
  { title: 'Fixed scope, fixed price', body: 'Every engagement has a written scope, a price, and a success measure. If the measure is not met, that is our problem to solve, not yours to absorb.' },
  { title: 'Systems your staff actually use', body: 'The test of a deployment is adoption. We build for the person doing the work on a Tuesday afternoon, not for the steering committee.' },
  { title: 'Seventeen years in regulated rooms', body: 'Built and shipped inside JPMorgan Chase, Scotiabank, KPMG, and a $5B specialty insurer. We know what an examiner looks for and what a clinical director will not tolerate.' },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="bg-grid-paper border-b border-cream-line">
    <div class="container-wide py-24 sm:py-32">
      <p class="eyebrow">AI implementation for regulated business</p>
      <h1 class="mt-6 max-w-4xl text-5xl leading-[1.05] text-balance sm:text-6xl lg:text-7xl">
        Working AI, inside the businesses that cannot afford to get it wrong.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted text-pretty">
        Tenorworth puts deployed agents, retrieval over your own documents, and workflow automation
        inside healthcare, financial, legal, and operations-heavy companies. Safely, on a fixed scope,
        with a measured return.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={contactHref()} class="btn-primary" data-event="cta_click" data-source="home_hero">Book a call</a>
        <a href="/services" class="btn-secondary">See the engagements</a>
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section class="container-wide grid gap-12 py-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="rule-brass mb-6"></div>
      <h2 class="text-3xl text-balance sm:text-4xl">Not strategy decks. Deployed systems.</h2>
    </div>
    <div class="space-y-6 text-lg leading-relaxed text-ink-muted lg:col-span-7 text-pretty">
      <p>
        Most AI advice stops at the recommendation. We start there. The work is putting a system
        into production, on your data, behind your access controls, and proving it earns its keep.
      </p>
      <p>
        That means the unglamorous parts are the whole job: the data boundary, the audit log, the
        fallback when the model is unsure, the training for the people who will use it, and the
        number you report to the board.
      </p>
    </div>
  </section>

  <!-- Engagements -->
  <section class="border-y border-cream-line bg-cream-deep/50">
    <div class="container-wide py-24">
      <p class="eyebrow">Three ways to engage</p>
      <h2 class="mt-4 max-w-2xl text-3xl text-balance sm:text-4xl">Fixed scope. Fixed price. A number at the end.</h2>
      <div class="mt-14 grid gap-px overflow-hidden rounded-lg border border-cream-line bg-cream-line md:grid-cols-3">
        {engagements.map((e) => (
          <article class="bg-cream p-8">
            <div class="flex items-baseline justify-between">
              <span class="font-display text-2xl text-brass">{e.step}</span>
              <span class="text-xs uppercase tracking-[0.14em] text-ink-muted">{e.length}</span>
            </div>
            <h3 class="mt-6 text-2xl">{e.name}</h3>
            <p class="mt-4 leading-relaxed text-ink-muted text-pretty">{e.body}</p>
          </article>
        ))}
      </div>
      <a href="/services" class="link-quiet mt-8 inline-block text-sm font-medium">Engagement details and what each one delivers</a>
    </div>
  </section>

  <!-- Who -->
  <section class="container-wide grid gap-12 py-24 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow">Who we serve</p>
      <h2 class="mt-4 text-3xl text-balance sm:text-4xl">Southern California businesses where trust is the product.</h2>
      <p class="mt-6 leading-relaxed text-ink-muted text-pretty">
        Small and mid-market operators with real compliance obligations and no appetite for
        experiments that put them at risk.
      </p>
    </div>
    <ul class="divide-y divide-cream-line lg:col-span-7">
      {sectors.map((s) => (
        <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-8">
          <span class="w-56 shrink-0 font-medium">{s.name}</span>
          <span class="text-ink-muted">{s.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Why us -->
  <section class="bg-ink text-cream">
    <div class="container-wide py-24">
      <p class="eyebrow text-brass">Why Tenorworth</p>
      <h2 class="mt-4 max-w-2xl text-3xl text-balance sm:text-4xl">The compliance questions get answered before the demo, not after.</h2>
      <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {principles.map((p) => (
          <div>
            <div class="rule-brass mb-4"></div>
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-cream/70 text-pretty">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA source="home_footer" />
</BaseLayout>
