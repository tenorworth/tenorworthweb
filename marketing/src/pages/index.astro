---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import EngagementArc from '../components/diagrams/EngagementArc.astro';
import HumanInLoop from '../components/diagrams/HumanInLoop.astro';
import GovernanceTimeline from '../components/diagrams/GovernanceTimeline.astro';
import { Image } from 'astro:assets';
import { contactHref } from '../config/site';
import { INDUSTRY_LIST, type IndustryId } from '../config/industries';
import clinic from '../assets/blog/community-clinic-front-desk-los-angeles.jpg';
import creditUnion from '../assets/blog/credit-union-branch-desk-orange-county.jpg';
import lawFirm from '../assets/blog/law-firm-office-century-city.jpg';
import biotech from '../assets/blog/biotech-qa-office-san-diego.jpg';
import hotel from '../assets/blog/hotel-back-office-palm-springs.jpg';

// Hero photograph (brand/image-prompts.md, C1). Drop the file at
// src/assets/home/hero.{jpg,png}; until it exists the hero stays text-only.
const heroFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/home/hero.{jpg,jpeg,png}', { eager: true });
const hero = Object.values(heroFiles)[0]?.default;

// "Who we serve" rows reuse the five sector photographs shot for Insights, so
// the room a visitor recognises on the home page is the room they land in on
// the sector hub.
const sectorPhotos: Record<IndustryId, ImageMetadata> = {
  'community-healthcare': clinic,
  'credit-unions': creditUnion,
  'law-firms': lawFirm,
  'life-sciences': biotech,
  hospitality: hotel,
};
const sectorAlts: Record<IndustryId, string> = {
  'community-healthcare': 'Front desk of a community health clinic in Los Angeles before opening',
  'credit-unions': 'Member-service desk in an Orange County credit union branch after closing',
  'law-firms': 'An office in a Century City law firm with a walnut desk and case files',
  'life-sciences': 'Quality-assurance office beside a San Diego biotech lab, SOP binders on a shelf',
  hospitality: 'Back office of a Palm Springs boutique hotel at dusk',
};

const engagements = [
  {
    step: '01',
    name: 'AI Readiness Roadmap',
    length: 'Two weeks',
    body: 'A fixed-fee assessment of where AI will pay back inside your operation, what data and governance are already in place, and what is missing. You leave with a ranked plan, not a slide deck.',
  },
  {
    step: '02',
    name: 'Pilot',
    length: 'Four to six weeks',
    body: 'One workflow, your real data, a working system your staff use. Scope, success metric, and data boundaries are agreed in writing before a line of code is written.',
  },
  {
    step: '03',
    name: 'Fractional AI Architect',
    length: 'Monthly retainer',
    body: 'Senior ownership of your AI program without a full-time hire. Vendor decisions, model governance, staff enablement, and the next pilot, with the same person accountable throughout.',
  },
];

const principles = [
  { title: 'Governance before the demo', body: 'Audit trail, access control, and data boundaries are designed first. The questions your compliance officer will ask get answered before anyone sees a prototype.' },
  { title: 'Fixed scope, fixed price', body: 'Every engagement has a written scope, a price, and a success measure. If the measure is not met, that is our problem to solve, not yours to absorb.' },
  { title: 'Systems your staff actually use', body: 'The test of a deployment is adoption. We build for the person doing the work on a Tuesday afternoon, not for the steering committee.' },
  { title: 'Seventeen years in regulated rooms', body: 'Built and shipped inside JPMorgan Chase, Scotiabank, Royal Bank of Scotland, KPMG, Highmark Health, and a $5B specialty insurer. We know what an examiner looks for and what a clinical director will not tolerate.' },
];
---
<BaseLayout>
  <!-- Hero -->
  <section class="bg-grid-paper border-b border-cream-line">
    <div class:list={['container-wide py-24 sm:py-32', hero && 'grid items-center gap-12 lg:grid-cols-12']}>
      <div class={hero ? 'lg:col-span-7' : ''}>
        <p class="eyebrow">AI implementation for regulated business</p>
        <h1 class="mt-6 max-w-4xl text-5xl leading-[1.05] text-balance sm:text-6xl lg:text-7xl">
          Working AI, inside the businesses that cannot afford to get it wrong.
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-muted text-pretty">
          Tenorworth puts deployed agents, retrieval over your own documents, and workflow automation
          inside healthcare, financial, legal, and operations-heavy companies. Safely, on a fixed scope,
          with a measured return.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={contactHref('home_hero')} class="btn-primary" data-event="cta_click" data-source="home_hero">Book a call</a>
          <a href="/services" class="btn-secondary">See the engagements</a>
        </div>
      </div>
      {hero && (
        <div class="lg:col-span-5">
          <Image
            src={hero}
            alt="A signed one-page agreement and a fountain pen on a walnut conference table, with the Los Angeles skyline through the window"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 440px, calc(100vw - 3rem)"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="aspect-[16/10] w-full rounded-lg object-cover object-[50%_62%] lg:aspect-[4/5] lg:object-center shadow-[0_24px_60px_-30px_rgba(20,27,45,0.45)]"
          />
        </div>
      )}
    </div>
  </section>

  <!-- Positioning -->
  <section class="container-wide py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="rule-brass mb-6"></div>
        <h2 class="text-3xl text-balance sm:text-4xl">Not strategy decks. Deployed systems.</h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink-muted lg:col-span-7 text-pretty">
        <p>
          Most AI advice stops at the recommendation. We start there. The work is putting a system
          into production, on your data, behind your access controls, and proving it earns its keep.
        </p>
        <p>
          That means the unglamorous parts are the whole job: the data boundary, the audit log, the
          fallback when the model is unsure, the training for the people who will use it, and the
          number you report to the board.
        </p>
      </div>
    </div>
    <div class="mt-16 rounded-lg border border-cream-line bg-cream-deep/40 p-6 sm:p-10">
      <p class="eyebrow">What a deployed workflow looks like</p>
      <HumanInLoop class="mt-6" />
      <p class="mt-4 text-sm text-ink-muted text-pretty">
        A person stays in the loop. The model drafts; a human approves anything above the confidence
        threshold and handles anything below it. Every step is written to a log your auditor can read.
      </p>
    </div>
  </section>

  <!-- Engagements -->
  <section class="border-y border-cream-line bg-cream-deep/50">
    <div class="container-wide py-24">
      <p class="eyebrow">Three ways to engage</p>
      <h2 class="mt-4 max-w-2xl text-3xl text-balance sm:text-4xl">Fixed scope. Fixed price. A number at the end.</h2>
      <EngagementArc class="mt-12" />
      <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-cream-line bg-cream-line md:grid-cols-3">
        {engagements.map((e) => (
          <article class="bg-cream p-8">
            <div class="flex items-baseline justify-between">
              <span class="font-display text-2xl text-brass">{e.step}</span>
              <span class="text-xs uppercase tracking-[0.14em] text-ink-muted">{e.length}</span>
            </div>
            <h3 class="mt-6 text-2xl">{e.name}</h3>
            <p class="mt-4 leading-relaxed text-ink-muted text-pretty">{e.body}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
        <a href={contactHref('home_engagements')} class="btn-primary" data-event="cta_click" data-source="home_engagements">Book a call</a>
        <a href="/services" class="link-quiet text-sm font-medium">Engagement details and what each one delivers</a>
      </div>
    </div>
  </section>

  <!-- Who -->
  <section class="container-wide py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Who we serve</p>
      <h2 class="mt-4 text-3xl text-balance sm:text-4xl">Southern California businesses where trust is the product.</h2>
      <p class="mt-6 leading-relaxed text-ink-muted text-pretty">
        Small and mid-market operators with real compliance obligations and no appetite for
        experiments that put them at risk. One workflow each, to start.
      </p>
    </div>
    <ul class="mt-14 divide-y divide-cream-line border-y border-cream-line">
      {INDUSTRY_LIST.map((s) => (
        <li class="grid gap-6 py-10 md:grid-cols-12 md:gap-10">
          <a href={`/insights/industry/${s.id}`} class="block overflow-hidden rounded-lg md:col-span-4" tabindex="-1" aria-hidden="true">
            <Image
              src={sectorPhotos[s.id]}
              alt={sectorAlts[s.id]}
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 340px, calc(100vw - 3rem)"
              format="webp"
              quality={78}
              loading="lazy"
              class="aspect-[16/9] w-full object-cover"
            />
          </a>
          <div class="md:col-span-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-2xl"><a href={`/insights/industry/${s.id}`} class="transition hover:text-brass-deep">{s.name}</a></h3>
              <span class="text-xs uppercase tracking-[0.14em] text-ink-muted">{s.region}</span>
            </div>
            <dl class="mt-5 grid gap-5 text-sm leading-relaxed sm:grid-cols-3 sm:gap-6">
              <div>
                <dt class="eyebrow">Problem</dt>
                <dd class="mt-2 text-ink-muted text-pretty">{s.problem}</dd>
              </div>
              <div>
                <dt class="eyebrow">We deploy</dt>
                <dd class="mt-2 text-ink text-pretty">{s.deployed}</dd>
              </div>
              <div>
                <dt class="eyebrow">We measure</dt>
                <dd class="mt-2 text-ink-muted text-pretty">{s.measure}</dd>
              </div>
            </dl>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Why us -->
  <section class="bg-ink text-cream">
    <div class="container-wide py-24">
      <p class="eyebrow text-brass">Why Tenorworth</p>
      <h2 class="mt-4 max-w-2xl text-3xl text-balance sm:text-4xl">The compliance questions get answered before the demo, not after.</h2>
      <GovernanceTimeline class="mt-12" />
      <div class="mt-16 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {principles.map((p) => (
          <div>
            <div class="rule-brass mb-4"></div>
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-cream/70 text-pretty">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA source="home_footer" principal />
</BaseLayout>
