---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex={true}>
  <section class="container-wide py-32">
    <p class="eyebrow">404</p>
    <h1 class="mt-6 text-4xl sm:text-5xl">That page is not here.</h1>
    <p class="mt-6 text-ink-muted">The address may have changed. Start again from the <a href="/" class="link-quiet text-ink">home page</a>.</p>
  </section>
</BaseLayout>
